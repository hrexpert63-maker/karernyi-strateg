BOT_TOKEN=             # токен от @BotFather
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
ADMIN_IDS=             # Telegram user id админов через запятую (узнать: @userinfobot)
CLUB_CHAT_ID=          # id чата/канала клуба, например -1001234567890 (бот должен быть админом)
CLUB_TOPIC_ID=         # необязательно: id темы, если в чате включены топики
LIBRARY_TOPIC_ID=      # необязательно: если видео библиотеки лежат в отдельной теме чата - id темы; пусто = индексируем все видео чата
TZ=Europe/Moscow
DIGEST_CRON=0 12 * * tue,fri   # когда готовить черновик подборки из библиотеки (локальное время)
AUTO_PUBLISH=false     # true - публиковать подборки без одобрения (анонсы и саммари всегда с одобрением)
